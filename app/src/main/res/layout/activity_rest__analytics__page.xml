<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Rest_Analytics_Page"
    android:background="@color/white">

    <Button
        android:id="@+id/btnGoToMoodStatus"
        android:layout_width="300dp"
        android:layout_height="58dp"
        android:text="Mood Status"
        app:backgroundTint="@color/yellow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.331" />

    <Button
        android:id="@+id/btnGoToAnalyseDay"
        android:layout_width="300dp"
        android:layout_height="58dp"
        android:text="Day Analysis"
        app:backgroundTint="@color/yellow"
        app:layout_constraintBottom_toTopOf="@+id/btnGoToAnalyseWeek"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.504"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnGoToMoodStatus" />

    <Button
        android:id="@+id/btnGoToAnalyseWeek"
        android:layout_width="300dp"
        android:layout_height="58dp"
        android:layout_marginBottom="256dp"
        android:text="Weekly Analysis"
        app:backgroundTint="@color/yellow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>